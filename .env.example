# Provider keys are entered in the app and held in sessionStorage.
# No provider API key is required in the server environment.

# Optional: enables Supabase sync and the analytics dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: enables server-side inference log ingestion.
NEXT_PUBLIC_APP_URL=http://localhost:3000

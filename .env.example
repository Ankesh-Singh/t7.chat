# Browser-safe Supabase URL and anon key enable email/password JWT auth.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only Supabase service role key. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Supabase Postgres connection string used only to apply migrations from a trusted machine or CI.
DATABASE_URL=

# Server-only 32+ character secret used for AES-GCM provider-key encryption.
AUTH_ENCRYPTION_KEY=

# Optional: enables server-side inference log callbacks.
NEXT_PUBLIC_APP_URL=http://localhost:3000
